{
  "name": "rtx-manual-to-md",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "convert": "tsx src/convert.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build:linux-x64": "bun build ./src/convert.ts --compile --target=bun-linux-x64 --outfile dist/rtx-manual-to-md-linux-x64",
    "build:linux-arm64": "bun build ./src/convert.ts --compile --target=bun-linux-arm64 --outfile dist/rtx-manual-to-md-linux-arm64",
    "build:win-x64": "bun build ./src/convert.ts --compile --target=bun-windows-x64 --outfile dist/rtx-manual-to-md-win-x64.exe",
    "build:darwin-x64": "bun build ./src/convert.ts --compile --target=bun-darwin-x64 --outfile dist/rtx-manual-to-md-darwin-x64",
    "build:darwin-arm64": "bun build ./src/convert.ts --compile --target=bun-darwin-arm64 --outfile dist/rtx-manual-to-md-darwin-arm64",
    "build:all": "npm run build:linux-x64 && npm run build:linux-arm64 && npm run build:win-x64 && npm run build:darwin-x64 && npm run build:darwin-arm64"
  },
  "dependencies": {
    "cheerio": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitepress": "^1.6.4"
  }
}
